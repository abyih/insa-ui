{
  "name": "react-dlux",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "proxy": "http://localhost:8181",
  "scripts": {
    "dev": "vite",
    "server": "node --watch server.js",
    "server:onos": "node --watch server-onos.js",
    "intent:service": "cd anomaly && uv run python intent_service.py",
    "all": "concurrently \"vite\" \"node --watch server.js\"",
    "all:onos": "concurrently \"vite\" \"node --watch server-onos.js\"",
    "all:onos:intent": "concurrently \"vite\" \"node --watch server-onos.js\" \"cd anomaly && uv run python intent_service.py\"",
    "build": "vite build",
    "test": "vitest --run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.3.1",
    "@tailwindcss/vite": "^4.1.11",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "framer-motion": "^12.23.6",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-json-tree": "^0.19.0",
    "react-json-view": "^1.21.3",
    "react-router-dom": "^7.0.2",
    "react-spinners": "^0.15.0",
    "recharts": "^3.5.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.11",
    "vis-data": "^7.1.9",
    "vis-network": "^9.1.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^29.0.2",
    "vite": "^6.0.1",
    "vitest": "^4.1.2"
  }
